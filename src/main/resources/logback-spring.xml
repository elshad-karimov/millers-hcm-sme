<?xml version="1.0" encoding="UTF-8"?>
<!--
  M164 (PRD §18.3): Structured logging configuration.

  In dev / local:
    - Console appender in human-readable pattern (coloured via Spring Boot default).
    - Loki appender ships JSON log lines to http://localhost:3100 (Loki container).
      If Loki is unreachable the appender buffers briefly then drops silently —
      the JVM startup is never blocked.

  In production:
    - Set LOKI_URL env var to the real Loki push endpoint.
    - Set LOG_LEVEL_ROOT to WARN or ERROR to reduce volume.

  Labels sent to Loki:
    app = millers-hcm
    env = ${spring.profiles.active}  (defaults to "local")
    host = hostname

  To query in Grafana:
    {app="millers-hcm"} |= "ERROR"
    {app="millers-hcm", env="local"} | json | line_format "{{.message}}"
-->
<configuration>

  <!-- ── Console appender (human-readable) ───────────────────────────────── -->
  <!-- M167: %X{traceId} and %X{spanId} are set by micrometer-tracing-bridge-otel
       so every log line carries the OTEL trace/span context — paste the traceId
       into Grafana → Explore → Jaeger to jump straight to the distributed trace. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId}] %cyan(%-40.40logger{40}) : %msg%n</pattern>
    </encoder>
  </appender>

  <!-- ── Rolling file appender ────────────────────────────────────────────
       Console logging alone means the logs live inside the container, and
       `docker compose up -d` REPLACES the container rather than restarting it.
       Every deploy therefore destroyed the evidence for anything reported just
       before it — three separate 500s were investigated this way, each traceId
       already unrecoverable by the time it was quoted.

       So the same lines also go to a file. Point HCM_LOG_DIR at a bind mount and
       the trail outlives the container that wrote it. Default is relative to
       WORKDIR (/app), which the non-root `hcm` user owns, so this is safe
       wherever it runs — it just isn't durable until something is mounted.
       Independent of the Loki appender below, which is opt-in and needs a
       server; a file needs nothing. -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${HCM_LOG_DIR:-logs}/hcm.log</file>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId}] %-40.40logger{40} : %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${HCM_LOG_DIR:-logs}/hcm.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <!-- 14 days is longer than any plausible gap between a user hitting an
           error and someone quoting the traceId; totalSizeCap is the real
           guard on a box with ~880MB free. -->
      <maxHistory>14</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <!-- ── Loki appender ────────────────────────────────────────────────────── -->
  <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
    <!-- Batch: send every 1 s or when 1 000 lines accumulate, whichever first -->
    <batchMaxItems>1000</batchMaxItems>
    <batchTimeoutMs>1000</batchTimeoutMs>
    <!-- Drop silently if Loki is unreachable rather than logging endlessly -->
    <dropRatioOnFull>0.1</dropRatioOnFull>

    <http>
      <url>${LOKI_URL:-http://localhost:3100}/loki/api/v1/push</url>
      <connectionTimeoutMs>5000</connectionTimeoutMs>
      <requestTimeoutMs>5000</requestTimeoutMs>
    </http>

    <format>
      <label>
        <pattern>app=millers-hcm,env=${spring.profiles.active:-local},host=${HOSTNAME:-localhost},level=%level</pattern>
        <readMarkers>true</readMarkers>
      </label>
      <message>
        <!-- Include traceId/spanId in the Loki log body for trace correlation -->
        <pattern>l=%level t=%thread traceId=%X{traceId} spanId=%X{spanId} logger=%logger{36} %msg%n</pattern>
      </message>
    </format>
  </appender>

  <!-- ── Async wrapper for Loki (non-blocking) ────────────────────────────── -->
  <appender name="LOKI_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="LOKI" />
    <neverBlock>true</neverBlock>
    <queueSize>512</queueSize>
  </appender>

  <!-- ── Reduce noise from chatty libraries ───────────────────────────────── -->
  <logger name="org.hibernate.SQL" level="WARN" />
  <logger name="org.hibernate.type.descriptor.sql" level="WARN" />
  <logger name="org.springframework.web.servlet.mvc.method.annotation" level="WARN" />
  <logger name="com.zaxxer.hikari" level="WARN" />
  <logger name="io.undertow" level="WARN" />
  <logger name="com.github.loki4j" level="WARN" />

  <!-- ── Root logger ──────────────────────────────────────────────────────── -->
  <root level="${LOG_LEVEL_ROOT:-INFO}">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
    <!--
      Loki shipping is OPT-IN via the "loki" profile.

      It used to be unconditional and defaults to http://localhost:3100. On any
      host without a Loki container that means every log line triggers a failing
      HTTP push with retries, and the retry failures are themselves logged — a
      feedback loop that produced 40k lines and pegged a core within a minute,
      and buried the real startup error that was underneath it.

      Turn it on with SPRING_PROFILES_ACTIVE=...,loki (and set LOKI_URL).
    -->
    <springProfile name="loki">
      <appender-ref ref="LOKI_ASYNC" />
    </springProfile>
  </root>

</configuration>
