{
  "title": "Millers HCM — Overview",
  "uid": "hcm-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Employees",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hcm_employees_active",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "On Probation",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hcm_employees_on_probation",
          "legendFormat": "Probation"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pending Approvals",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hcm_workflow_pending",
          "legendFormat": "Pending"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"millers-hcm\"}[1m]))",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Error Rate",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"millers-hcm\",status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM Heap Used (MB)",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "jvm_memory_used_bytes{application=\"millers-hcm\",area=\"heap\"} / 1048576",
          "legendFormat": "Heap MB"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB Connection Pool (active)",
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hikaricp_connections_active{application=\"millers-hcm\"}",
          "legendFormat": "Active connections"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p99 API Latency (ms)",
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"millers-hcm\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Application Logs — ERROR / WARN",
      "description": "Live log stream from Loki (M164). Filtered to WARN+ to surface issues without noise.",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{app=\"millers-hcm\"} |= \"\" | logfmt | level =~ \"WARN|ERROR\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Log Rate by Level (lines/min)",
      "description": "Count of log lines per minute grouped by level — spike indicates an incident.",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 6 },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (level) (rate({app=\"millers-hcm\"}[1m]))",
          "legendFormat": "{{level}}"
        }
      ]
    }
  ]
}
