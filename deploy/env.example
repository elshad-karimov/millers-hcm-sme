# Copy to `.env` NEXT TO docker-compose.yml on the VPS and fill in.
# That copy is git-ignored — it holds live credentials and must never be
# committed. This template holds none.

# ── Image ───────────────────────────────────────────────────────────────────
# GitHub org/user that owns the GHCR package.
GHCR_OWNER=elshad-karimov
# Overwritten by the deploy workflow on every roll; the value here is only the
# fallback for a manual `docker compose up`.
HCM_IMAGE_TAG=latest

# ── Public address ──────────────────────────────────────────────────────────
# The origin BROWSERS use. It becomes the OIDC issuer and Keycloak's advertised
# hostname, so it must match exactly — scheme, host and port. Include the port
# if you are not terminating on 443 (e.g. https://sme.millers-software.com:8543).
PUBLIC_URL=https://sme.millers-software.com

# Host ports for nginx. Defaults keep clear of the enterprise stack (8443/8444).
PUBLIC_HTTPS_PORT=8543
PUBLIC_HTTP_PORT=8544

# ── TLS ─────────────────────────────────────────────────────────────────────
# Absolute paths ON THE VPS. With Let's Encrypt these are usually
# /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem.
TLS_CERT_PATH=/etc/letsencrypt/live/sme.millers-software.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/sme.millers-software.com/privkey.pem

# ── Application database ────────────────────────────────────────────────────
POSTGRES_USER=hcm
POSTGRES_PASSWORD=CHANGE_ME

# ── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# ── Encryption ──────────────────────────────────────────────────────────────
# AES key for encrypted PII columns (national id, bank details).
# Generate once:  openssl rand -base64 32
# CHANGING OR LOSING THIS MAKES EVERY EXISTING ENCRYPTED ROW UNREADABLE.
# Keep a copy somewhere other than this VPS.
HCM_SECURITY_DATA_KEY=CHANGE_ME

# ── Mail (optional) ─────────────────────────────────────────────────────────
HCM_MAIL_HOST=localhost
HCM_MAIL_PORT=1025
HCM_MAIL_FROM=no-reply@millers-software.com

# ── Optional services, off unless the box actually runs them ────────────────
HCM_STORAGE_MINIO_ENABLED=false
HCM_VIRUS_SCAN_ENABLED=false
